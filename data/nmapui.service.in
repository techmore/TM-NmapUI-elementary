[Unit]
Description=TM-NmapUI scanner engine (per-user, loopback only)
Documentation=https://github.com/techmore/TM-NmapUI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
Environment=NMAPUI_HOST=127.0.0.1
Environment=NMAPUI_PORT=9000
Environment=NMAPUI_DATA_DIR=%h/.local/share/nmapui
Environment=NMAPUI_LOG_DIR=%h/.local/share/nmapui/logs
Environment=NMAPUI_COOKIE_SECURE=false
Environment=NMAPUI_ENABLE_UPDATE_CHECK=false
# One threaded worker: Socket.IO connections and the job registry are process-local.
ExecStart=@APP_DIR@/.venv/bin/python -m gunicorn --bind 127.0.0.1:9000 --workers 1 --threads 100 --timeout 180 --graceful-timeout 30 --no-control-socket nmapui.wsgi:application
Restart=on-failure
RestartSec=3
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
