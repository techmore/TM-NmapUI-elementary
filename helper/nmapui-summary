#!/usr/bin/env python3
"""Print a one-shot JSON summary of the local scanner for the Wingpanel indicator.

Reads only the scanner's loopback HTTP API. Anything it cannot read stays null so
the panel shows "unknown" rather than inventing a value.
"""
import datetime
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("NMAPUI_URL", "http://127.0.0.1:9000").rstrip("/")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect (for example to /login) is a refusal, not data."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_opener = urllib.request.build_opener(_NoRedirect)


def get(path, statuses=None):
    """GET JSON from the engine. When `statuses` is a dict, record the HTTP status of a refusal."""
    try:
        request = urllib.request.Request(BASE + path, headers={"Accept": "application/json"})
        with _opener.open(request, timeout=3) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if statuses is not None:
            statuses[path] = error.code
        return None
    except (OSError, ValueError):
        return None


def run_json(command):
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=3, check=True).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def network_info(default_interface):
    """Local network facts from the kernel; nothing is fetched from the internet."""
    info = {"interface": None, "address": None, "cidr": None, "gateway": None, "ssid": None}
    routes = run_json(["ip", "-j", "route", "show", "default"]) or []
    route = next((r for r in routes if not default_interface or r.get("dev") == default_interface), routes[0] if routes else None)
    interface = (route or {}).get("dev") or default_interface
    if not interface:
        return info
    info["interface"] = interface
    info["gateway"] = (route or {}).get("gateway")
    for entry in run_json(["ip", "-j", "-4", "addr", "show", "dev", interface]) or []:
        for addr in entry.get("addr_info", []):
            if addr.get("family") == "inet":
                info["address"] = addr.get("local")
                prefix = addr.get("prefixlen")
                if info["address"] and isinstance(prefix, int):
                    import ipaddress
                    info["cidr"] = str(ipaddress.ip_interface(f"{info['address']}/{prefix}").network)
                break
    try:
        ssid = subprocess.run(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"], capture_output=True, text=True, timeout=3).stdout
        info["ssid"] = next((line.split(":", 1)[1] for line in ssid.splitlines() if line.startswith("yes:")), None) or None
    except (OSError, subprocess.SubprocessError):
        pass
    return info


def number(value):
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def runtime_valid(runtime):
    """Same rule as the app's RuntimeSchema: only a readable snapshot can say the scanner is idle."""
    if not isinstance(runtime, dict) or not isinstance(runtime.get("active_jobs"), list):
        return False
    for job in runtime["active_jobs"]:
        if not isinstance(job, dict) or not isinstance(job.get("job_type"), str) or not job["job_type"]:
            return False
        if job.get("status") not in ("running", "cancelling"):
            return False
        if job["job_type"] != "scan":
            continue
        if any(key in job and not isinstance(job[key], bool) for key in ("paused", "pause_requested")):
            return False
        details = job.get("details")
        if details is None:
            continue
        if not isinstance(details, dict):
            return False
        if any(details.get(key) is not None and not isinstance(details[key], str) for key in ("message", "target")):
            return False
        if any(details.get(key) is not None and not _is_number(details[key]) for key in ("progress", "host_count")):
            return False
        if details.get("host_count") is not None and not 0 <= details["host_count"] <= 2**31 - 1:
            return False
    return True


def unavailable_reason(status):
    if status in (401, 403) or (status is not None and 300 <= status < 400):
        return f"The scanner refused the status request (HTTP {status}). Sign in to the scanner, or allow local access."
    if status == 503:
        return "The scanner refuses status requests until its sign-in is set up securely (HTTP 503)."
    if status is not None:
        return f"The scanner answered the status request with HTTP {status}."
    return "The scanner's status reply couldn't be read."


def summarize(health, runtime, history, auto, live=None, runtime_status=None):
    out = {"state": "offline", "label": "Scanner service is not running", "reason": None, "version": None, "progress": None,
           "message": None, "hosts": None, "changes": None, "critical": None, "last_scan": None,
           "last_customer": None, "monitor": None, "alerts": [], "tools_missing": [], "network": None, "scan": None, "devices": []}
    if not isinstance(health, dict):
        return out
    out["version"] = health.get("app_version")
    out["network"] = network_info(health.get("default_interface"))
    tools = health.get("tool_versions") or {}
    out["tools_missing"] = sorted(name for name in ("nmap",) if str(tools.get(name, "")).lower().startswith("not installed"))
    if not runtime_valid(runtime):
        # The service answers but its activity can't be read; never report that as idle.
        out["state"], out["label"] = "unavailable", "Status unavailable"
        out["reason"] = unavailable_reason(runtime_status)
        return out
    out["state"], out["label"] = "idle", "Idle"
    jobs = runtime["active_jobs"]
    scan = next((j for j in jobs if j.get("job_type") == "scan"), None)
    if scan:
        details = scan.get("details") or {}
        out["state"] = "stopping" if scan.get("status") == "cancelling" else "scanning"
        out["label"] = "Stopping scan" if out["state"] == "stopping" else "Scanning"
        out["progress"] = number(details.get("progress")) if number(details.get("progress")) is not None else None
        out["message"] = details.get("message")
        out["hosts"] = number(details.get("host_count"))
        step = re.search(r"(\d+)/(\d+)(?::\s*(\S+))?", str(details.get("message") or ""))
        out["scan"] = {"target": details.get("target"), "phase": details.get("phase"),
                       "customer": details.get("customer_name"), "started_at": scan.get("started_at"),
                       "index": int(step[1]) if step else None, "total": int(step[2]) if step else None,
                       "current": step[3] if step and step[3] else None}
        try:
            started = datetime.datetime.fromisoformat(str(scan.get("started_at")))
            out["scan"]["elapsed_seconds"] = max(0, int((datetime.datetime.now() - started).total_seconds()))
        except ValueError:
            out["scan"]["elapsed_seconds"] = None
        if out["hosts"] is None and out["scan"]["total"]:
            out["hosts"] = out["scan"]["total"]
    rows = (history or {}).get("history") if isinstance(history, dict) else None
    if rows:
        last = rows[0]
        out["last_scan"] = last.get("timestamp")
        out["last_customer"] = last.get("customer_name")
        if out["hosts"] is None:
            out["hosts"] = number(last.get("host_count", last.get("total_hosts")))
        diff = last.get("diff_summary") or {}
        if diff.get("has_changes"):
            out["changes"] = number(diff.get("change_count")) or 1
            out["alerts"].append("Changes since the previous scan")
        out["critical"] = number(last.get("critical_cves", last.get("critical_count")))
        if out["critical"]:
            out["alerts"].append(f"{out['critical']} critical CVE" + ("s" if out["critical"] != 1 else ""))
    devices = []
    for host in ((live or {}).get("hosts") or [])[:200] if isinstance(live, dict) else []:
        if isinstance(host, dict) and host.get("ip"):
            devices.append({"ip": host["ip"], "name": host.get("hostname") or "", "vendor": host.get("vendor") or "",
                            "open_ports": number(host.get("open_ports"))})
    devices.sort(key=lambda d: [int(part) if part.isdigit() else 0 for part in str(d["ip"]).split(".")])
    out["devices"] = devices
    if out["hosts"] is None and devices:
        out["hosts"] = len(devices)
    if isinstance(auto, dict) and auto.get("enabled"):
        out["monitor"] = auto.get("next_run") or "Enabled"
    if out["tools_missing"]:
        out["alerts"].append("nmap is not installed; scans cannot run")
    if out["state"] == "idle" and out["alerts"]:
        out["state"], out["label"] = "attention", "Needs attention"
    return out


def main():
    statuses = {}
    runtime = get("/api/runtime/status", statuses)
    print(json.dumps(summarize(get("/api/health"), runtime, get("/api/runtime/history"),
                               get("/api/auto_scan/status"), get("/api/runtime/live-hosts"),
                               runtime_status=statuses.get("/api/runtime/status"))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
