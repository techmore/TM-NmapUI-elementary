#!/usr/bin/env python3
"""Print a one-shot JSON summary of the local scanner for the Wingpanel indicator.

Reads only the scanner's loopback HTTP API. Anything it cannot read stays null so
the panel shows "unknown" rather than inventing a value.
"""
import datetime
import ipaddress
from concurrent.futures import ThreadPoolExecutor
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("NMAPUI_URL", "http://127.0.0.1:9000").rstrip("/")
MAX_RESPONSE_BYTES = 2 * 1024 * 1024


def get(path):
    try:
        with urllib.request.urlopen(BASE + path, timeout=3) as response:
            body = response.read(MAX_RESPONSE_BYTES + 1)
            if len(body) > MAX_RESPONSE_BYTES:
                return None
            payload = json.loads(body)
            return payload if isinstance(payload, dict) else None
    except (OSError, ValueError, urllib.error.URLError):
        return None


def run_json(command):
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=3, check=True).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def network_info(default_interface):
    """Local network facts from the kernel; nothing is fetched from the internet."""
    info = {"interface": None, "address": None, "cidr": None, "gateway": None, "ssid": None}
    routes = objects(run_json(["ip", "-j", "route", "show", "default"]))
    route = next((r for r in routes if not default_interface or r.get("dev") == default_interface), routes[0] if routes else None)
    interface = (route or {}).get("dev") or default_interface
    if not interface:
        return info
    info["interface"] = interface
    info["gateway"] = (route or {}).get("gateway")
    for entry in objects(run_json(["ip", "-j", "-4", "addr", "show", "dev", interface])):
        for addr in objects(entry.get("addr_info")):
            if addr.get("family") == "inet":
                info["address"] = addr.get("local")
                prefix = addr.get("prefixlen")
                if info["address"] and isinstance(prefix, int):
                    import ipaddress
                    try:
                        info["cidr"] = str(ipaddress.ip_interface(f"{info['address']}/{prefix}").network)
                    except ValueError:
                        pass
                break
    try:
        # Listing access points must not initiate a Wi-Fi rescan every poll.
        ssid = subprocess.run(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi", "list", "ifname", interface, "--rescan", "no"],
                              capture_output=True, text=True, timeout=3).stdout
        info["ssid"] = next((line.split(":", 1)[1] for line in ssid.splitlines() if line.startswith("yes:")), None) or None
    except (OSError, subprocess.SubprocessError):
        pass
    return info


def number(value):
    return value if isinstance(value, int) and not isinstance(value, bool) and -(2**31) <= value < 2**31 else None


def objects(value):
    return [item for item in value if isinstance(item, dict)] if isinstance(value, list) else []


def text(value):
    return value if isinstance(value, str) else None


def valid_runtime(runtime):
    if not isinstance(runtime, dict) or not isinstance(runtime.get("active_jobs"), list):
        return False
    for job in runtime["active_jobs"]:
        if not isinstance(job, dict) or not text(job.get("job_type")) or job.get("status") not in ("running", "cancelling"):
            return False
        if job["job_type"] != "scan":
            continue
        if any(key in job and not isinstance(job[key], bool) for key in ("paused", "pause_requested")):
            return False
        details = job.get("details")
        if details is None:
            continue
        if not isinstance(details, dict):
            return False
        if any(details.get(key) is not None and not isinstance(details[key], str) for key in ("message", "target")):
            return False
        if any(details.get(key) is not None and (not isinstance(details[key], int) or isinstance(details[key], bool)) for key in ("progress", "host_count")):
            return False
        if details.get("host_count") is not None and (number(details["host_count"]) is None or details["host_count"] < 0):
            return False
    return True


def summarize(health, runtime, history, auto, live=None):
    out = {"state": "offline", "label": "Scanner service is not running", "version": None, "progress": None,
           "message": None, "hosts": None, "changes": None, "critical": None, "last_scan": None,
           "last_customer": None, "monitor": None, "alerts": [], "tools_missing": [], "network": None, "scan": None, "devices": []}
    if not isinstance(health, dict):
        return out
    out["version"] = text(health.get("app_version"))
    out["network"] = network_info(text(health.get("default_interface")))
    tools = health.get("tool_versions") if isinstance(health.get("tool_versions"), dict) else {}
    out["tools_missing"] = sorted(name for name in ("nmap",) if str(tools.get(name, "")).lower().startswith("not installed"))
    out["state"], out["label"] = "idle", "Idle"
    if not valid_runtime(runtime):
        out["state"], out["label"] = "unknown", "Scanner activity unavailable"
        out["alerts"].append("Scan activity could not be read; open the scanner to check access and status")
    jobs = runtime["active_jobs"] if valid_runtime(runtime) else []
    scan = next((j for j in jobs if j.get("job_type") == "scan"), None)
    if scan:
        details = scan.get("details") if isinstance(scan.get("details"), dict) else {}
        out["state"] = "stopping" if scan.get("status") == "cancelling" else "scanning"
        out["label"] = "Stopping scan" if out["state"] == "stopping" else "Scanning"
        if out["state"] != "stopping" and scan.get("paused") is True:
            out["state"], out["label"] = "paused", "Scan paused"
        elif out["state"] != "stopping" and scan.get("pause_requested") is True:
            out["state"], out["label"] = "pausing", "Pausing scan"
        out["progress"] = number(details.get("progress")) if number(details.get("progress")) is not None else None
        if out["progress"] is not None:
            out["progress"] = max(0, min(100, out["progress"]))
        out["message"] = text(details.get("message"))
        out["hosts"] = number(details.get("host_count"))
        step = re.search(r"(\d+)/(\d+)(?::\s*(\S+))?", str(details.get("message") or ""))
        out["scan"] = {"target": text(details.get("target")), "phase": text(details.get("phase")),
                       "customer": text(details.get("customer_name")), "started_at": text(scan.get("started_at")),
                       "index": int(step[1]) if step else None, "total": int(step[2]) if step else None,
                       "current": step[3] if step and step[3] else None}
        try:
            started = datetime.datetime.fromisoformat(str(scan.get("started_at")))
            out["scan"]["elapsed_seconds"] = max(0, int((datetime.datetime.now(started.tzinfo) - started).total_seconds()))
        except (TypeError, ValueError):
            out["scan"]["elapsed_seconds"] = None
        if out["hosts"] is None and out["scan"]["total"]:
            out["hosts"] = out["scan"]["total"]
    rows = objects(history.get("history")) if isinstance(history, dict) else []
    if rows:
        last = rows[0]
        out["last_scan"] = text(last.get("timestamp"))
        out["last_customer"] = text(last.get("customer_name"))
        if out["hosts"] is None:
            out["hosts"] = number(last.get("host_count", last.get("total_hosts")))
        diff = last.get("diff_summary") if isinstance(last.get("diff_summary"), dict) else {}
        if diff.get("has_changes") is True:
            out["changes"] = number(diff.get("change_count")) or 1
            out["alerts"].append("Changes since the previous scan")
        out["critical"] = number(last.get("critical_cves", last.get("critical_count")))
        if out["critical"]:
            out["alerts"].append(f"{out['critical']} critical CVE" + ("s" if out["critical"] != 1 else ""))
    devices = []
    for host in objects(live.get("hosts"))[:200] if isinstance(live, dict) else []:
        if text(host.get("ip")):
            try:
                ipaddress.ip_address(host["ip"])
            except ValueError:
                continue
            devices.append({"ip": host["ip"], "name": text(host.get("hostname")) or "", "vendor": text(host.get("vendor")) or "",
                            "open_ports": number(host.get("open_ports"))})
    devices.sort(key=lambda d: (ipaddress.ip_address(d["ip"]).version, int(ipaddress.ip_address(d["ip"]))))
    out["devices"] = devices
    if out["hosts"] is None and devices:
        out["hosts"] = len(devices)
    if isinstance(auto, dict) and auto.get("enabled") is True:
        out["monitor"] = text(auto.get("next_run")) or "Enabled"
    if out["tools_missing"]:
        out["alerts"].append("nmap is not installed; scans cannot run")
    if out["state"] == "idle" and out["alerts"]:
        out["state"], out["label"] = "attention", "Needs attention"
    return out


def main():
    health = get("/api/health")
    if not isinstance(health, dict):
        print(json.dumps(summarize(None, None, None, None)))
        return 0
    # Independent reads share one timeout window instead of accumulating four
    # sequential HTTP timeouts and leaving the dropdown on stale data.
    with ThreadPoolExecutor(max_workers=4) as pool:
        runtime, history, auto, live = pool.map(get, (
            "/api/runtime/status", "/api/runtime/history", "/api/auto_scan/status", "/api/runtime/live-hosts",
        ))
    print(json.dumps(summarize(health, runtime, history, auto, live)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
